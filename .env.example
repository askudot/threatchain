# ThreatChain Environment Configuration

# MiMo API Configuration (via 9Router)
MIMO_API_KEY=your-mimo-api-key-here
MIMO_BASE_URL=http://localhost:20128/v1
MIMO_MODEL=xmtp/mimo-v2.5-pro

# Blockchain API Keys
ETHERSCAN_API_KEY=your-etherscan-key
BSCSCAN_API_KEY=your-bscscan-key
POLYGONSCAN_API_KEY=your-polygonscan-key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# On-Chain Oracle Configuration
ORACLE_CONTRACT_ADDRESS_ETH=0x...
ORACLE_CONTRACT_ADDRESS_BSC=0x...
ORACLE_CONTRACT_ADDRESS_POLYGON=0x...
ORACLE_PRIVATE_KEY=your-private-key-for-oracle-updates

# Alert System Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
DISCORD_WEBHOOK_URL=your-discord-webhook-url
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=alerts@threatchain.io
EMAIL_PASSWORD=your-email-password

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/threatchain
REDIS_URL=redis://localhost:6379/0

# Monitoring Configuration
SCAN_INTERVAL_SECONDS=900
ALERT_THRESHOLD_SCORE=40
PUBLISH_THRESHOLD_SCORE=60

# Feature Flags
ENABLE_ON_CHAIN_PUBLISHING=false
ENABLE_ALERTS=true
ENABLE_COMMUNITY_INTEL=true
